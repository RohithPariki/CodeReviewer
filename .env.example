# Anthropic API key (required for running agents)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub personal access token (required for PR fetching + posting comments)
# Needs: repo, pull_requests scopes
GITHUB_TOKEN=ghp_...

# Optional: model override (default: claude-haiku-20240307)
# ANTHROPIC_MODEL=claude-haiku-20240307

# Optional: minimum severity to post as PR comment (LOW|MEDIUM|HIGH)
# MIN_SEVERITY_TO_POST=LOW
